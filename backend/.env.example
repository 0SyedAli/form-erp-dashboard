# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# For local replica set (port 27018) or standalone development:
MONGODB_URI=mongodb://127.0.0.1:27018/moltyformerp?replicaSet=rs0

# Security & Session
SESSION_SECRET=molty-foam-erp-super-secret-key-change-in-production-2026
SESSION_TTL_HOURS=24
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS & Client
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Logging
LOG_LEVEL=info

# Initial Provisioning Passwords (Required for database seeding; never commit production passwords)
SEED_ADMIN_PASSWORD=your_secure_admin_initial_password_here
SEED_BRANCH_PASSWORD=your_secure_branch_initial_password_here

